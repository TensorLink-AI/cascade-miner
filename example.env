# Copy this file to .env and replace every placeholder you use.
# Never commit .env or real credentials.

# Hugging Face access (needed for gated/private datasets and HF fallback uploads)
HF_TOKEN=hf_replace_me

# Hippius Hub token used to upload generator artefacts for deployment.
HIPPIUS_HUB_TOKEN=replace_me

# Lium GPU rental CLI authentication (only needed for paid evaluation).
LIUM_API_KEY=replace_me

# Private key used to reach rented pods. Defaults to the path lium recorded in
# ~/.lium/config.ini, then ~/.ssh/id_ed25519. Set it if yours lives elsewhere.
# LIUM_SSH_KEY=/path/to/id_ed25519

# Public SS58 hotkey used by the controller to find this miner in receipts.
CASCADE_MINER_HOTKEY=replace_me

# human: queue GPU work for approval; autonomous: run the configured evaluation
# command automatically. Neither mode accesses wallets or submits on-chain.
CASCADE_MODE=human

# Improvement agent: auto, claude, codex, hermes, hermes-native, or custom.
# "auto" picks the first of claude/codex/hermes found on PATH, so make sure the
# CLI you want is on it (hermes often installs to /opt/hermes/bin).
CASCADE_AGENT=auto

# For any other non-interactive agent, select "custom" and provide a command.
# If {prompt} appears it is replaced in-place; otherwise the prompt is sent on stdin.
# CASCADE_AGENT_COMMAND=my-agent run --prompt {prompt}

# "hermes-native" is for running the controller from inside an agent session,
# where there is no CLI for the agent to invoke itself with. The hook publishes
# runs/improve-request.json and waits for runs/improve-response.json instead.
# It is never chosen by "auto" — select it deliberately.
# CASCADE_IMPROVE_RESPONSE_TIMEOUT=3600
# CASCADE_IMPROVE_RESPONSE_POLL_SECONDS=5

# Progress reporting while a backgrounded remote evaluation runs.
# CASCADE_PROGRESS_POLL_SECONDS=30
# CASCADE_PROGRESS_HEARTBEAT_SECONDS=600

# Optional command that sends approval events to a human-facing channel.
# It receives the event JSON in CASCADE_MINER_EVENT.
# CASCADE_NOTIFY_COMMAND=your-notifier-command

# Paid evaluation entry point. The controller runs this only after `--approve`
# in human mode, or when explicitly allowlisted in autonomous mode.
CASCADE_APPROVED_EVAL_COMMAND=".venv/bin/python scripts/run-gpu-evaluation"

# Which eval-pool snapshot the controller mirrors: latest (default), all, or a
# dated snapshot name. "all" is 10k+ files and can be rate-limited by the Hub.
CASCADE_EVAL_POOL_SNAPSHOT=latest

# Paired evaluation settings used by the shipped command.
CASCADE_EVAL_SEEDS=0,1,2
CASCADE_TRAIN_HOURS=1
CASCADE_GPU=RTX4090

# Max concurrent trainings per pod (run-gpu-evaluation --parallel). 1 = the
# strictly serial default; one training uses a small slice of the card, so
# ablation batches can go higher.
# CASCADE_EVAL_PARALLEL=1

# Explicit seed->warm-init pairing for warm-started evals, e.g.
# "0=warm/r27,1=warm/r29,2=warm/r30". Must cover every eval seed; both arms
# of a seed share its init. Empty = train from whatever the trainer defaults to.
# CASCADE_WARM_MAP=

# Mirror ckpts/ home continuously alongside scores/ (default on). A pulled
# checkpoint with its TRAINED.json means a resumed run skips that training.
# CASCADE_PULL_CKPTS=1

# Resume a run after a pod death: skip arms already scored locally and push
# completed local checkpoints back. Only for re-running the IDENTICAL
# candidate — resuming a changed candidate keeps stale results.
# CASCADE_EVAL_RESUME=0

# Privileged Bittensor actions. Point these at non-interactive, operator-owned
# wrappers. Never put wallet passwords or mnemonics in these command strings.
# CASCADE_CREATE_HOTKEY_COMMAND=./ops/create-next-hotkey
# CASCADE_REGISTER_HOTKEY_COMMAND=./ops/register-next-hotkey
# CASCADE_SUBMIT_COMMAND=./ops/submit-candidate

# Autonomous mode executes only these named actions. Human mode always queues
# them for approval. Add wallet/chain actions only after deliberate review.
CASCADE_AUTONOMOUS_ACTIONS=gpu_evaluation
