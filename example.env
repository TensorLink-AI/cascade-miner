# Copy this file to .env and replace every placeholder you use.
# Never commit .env or real credentials.

# Hugging Face access (needed for gated/private datasets and HF fallback uploads)
HF_TOKEN=hf_replace_me

# Hippius registry: use a token OR the username/password pair.
HIPPIUS_HUB_TOKEN=replace_me
# HIPPIUS_HUB_USERNAME=replace_me
# HIPPIUS_HUB_PASSWORD=replace_me

# Hippius S3 access for manifests, receipts, and pool storage.
HIPPIUS_S3_ACCESS_KEY=replace_me
HIPPIUS_S3_SECRET_KEY=replace_me

# Optional dedicated eval-pool S3 credentials. When omitted, Cascade falls
# back to HIPPIUS_S3_ACCESS_KEY and HIPPIUS_S3_SECRET_KEY.
# POOL_S3_ACCESS_KEY=replace_me
# POOL_S3_SECRET_KEY=replace_me

# Lium GPU rental CLI authentication.
LIUM_API_KEY=replace_me

# Public SS58 hotkey used by the controller to find this miner in receipts.
CASCADE_MINER_HOTKEY=replace_me

# human: queue GPU work for approval; autonomous: run the configured evaluation
# command automatically. Neither mode accesses wallets or submits on-chain.
CASCADE_MODE=human

# Improvement agent: auto, claude, codex, hermes, or custom.
CASCADE_AGENT=auto

# For any other non-interactive agent, select "custom" and provide a command.
# If {prompt} appears it is replaced in-place; otherwise the prompt is sent on stdin.
# CASCADE_AGENT_COMMAND=my-agent run --prompt {prompt}

# Optional command that sends approval events to a human-facing channel.
# It receives the event JSON in CASCADE_MINER_EVENT.
# CASCADE_NOTIFY_COMMAND=your-notifier-command

# Paid evaluation entry point. The controller runs this only after `--approve`
# in human mode, or when explicitly allowlisted in autonomous mode.
CASCADE_APPROVED_EVAL_COMMAND=.venv/bin/python scripts/run-gpu-evaluation

# Paired evaluation settings used by the shipped command.
CASCADE_EVAL_SEEDS=0,1,2
CASCADE_TRAIN_HOURS=1
CASCADE_GPU=RTX4090

# Privileged Bittensor actions. Point these at non-interactive, operator-owned
# wrappers. Never put wallet passwords or mnemonics in these command strings.
# CASCADE_CREATE_HOTKEY_COMMAND=./ops/create-next-hotkey
# CASCADE_REGISTER_HOTKEY_COMMAND=./ops/register-next-hotkey
# CASCADE_SUBMIT_COMMAND=./ops/submit-candidate

# Autonomous mode executes only these named actions. Human mode always queues
# them for approval. Add wallet/chain actions only after deliberate review.
CASCADE_AUTONOMOUS_ACTIONS=gpu_evaluation
