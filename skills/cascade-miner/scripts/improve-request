#!/usr/bin/env python3
"""Read and answer the improvement request published by `CASCADE_AGENT=hermes-native`.

The improvement hook writes `runs/improve-request.json` and blocks on
`runs/improve-response.json`. An in-session agent uses this to see what was
asked and to close the pass out.

    improve-request show
    improve-request respond --status completed --detail "what changed"
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
REQUEST = ROOT / "runs/improve-request.json"
RESPONSE = ROOT / "runs/improve-response.json"
STATUSES = ("completed", "failed", "rejected", "skipped")


def load_request() -> dict:
    if not REQUEST.is_file():
        raise SystemExit(f"no pending improvement request at {REQUEST}")
    try:
        payload = json.loads(REQUEST.read_text(encoding="utf-8"))
    except ValueError as exc:
        raise SystemExit(f"{REQUEST} is not valid JSON: {exc}") from exc
    if not payload.get("id"):
        raise SystemExit(f"{REQUEST} has no request id")
    return payload


def show(args: argparse.Namespace) -> int:
    request = load_request()
    if args.json:
        print(json.dumps(request, indent=2, sort_keys=True))
        return 0
    print(f"id:        {request['id']}")
    print(f"status:    {request.get('status', '')}")
    print(f"requested: {request.get('requested_at', '')}")
    print(f"mode:      {request.get('mode', '')}")
    event = request.get("event") or {}
    if event:
        print(f"event:     {event.get('type', '')} round={event.get('round_id', '')}")
    print()
    print(request.get("prompt", "").rstrip())
    return 0


def respond(args: argparse.Namespace) -> int:
    request = load_request()
    # Answer the request that is actually pending; a stale id would be ignored
    # by the hook and the pass would block until it times out.
    payload = {
        "id": request["id"],
        "status": args.status,
        "detail": args.detail,
        "responded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    RESPONSE.parent.mkdir(parents=True, exist_ok=True)
    temporary = RESPONSE.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
    temporary.replace(RESPONSE)
    print(f"answered {request['id']}: {args.status}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    viewer = sub.add_parser("show", help="print the pending request")
    viewer.add_argument("--json", action="store_true", help="print the raw record")
    viewer.set_defaults(func=show)

    answer = sub.add_parser("respond", help="close out the pending request")
    answer.add_argument("--status", choices=STATUSES, required=True)
    answer.add_argument("--detail", default="", help="one line on what was done")
    answer.set_defaults(func=respond)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
